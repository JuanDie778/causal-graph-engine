  "edges": [
    {
      "source": "base_demand",
      "target": "demand",
      "type": "exact_code",
      "sensitivity_weight": 0.925,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "demand = base_demand * (1 - 0.15*(price-3)) + 8*sqrt(marketing_budget)"
      }
    },
    {
      "source": "price",
      "target": "demand",
      "type": "exact_code",
      "sensitivity_weight": -150.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "ddemand/dprice = -0.15 * base_demand"
      }
    },
    {
      "source": "marketing_budget",
      "target": "demand",
      "type": "exact_code",
      "sensitivity_weight": 0.178,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "ddemand/dmarketing = 4 / sqrt(marketing_budget)"
      }
    },
    {
      "source": "marketing_budget",
      "target": "demand",
      "type": "empirical_data",
      "sensitivity_weight": 0.18,
      "confidence": 0.95,
      "exact_mechanism": {
        "engine": "statistical_regression",
        "definition": "estimated lift: 8.0 * sqrt(marketing_budget) from sales_history.csv"
      }
    },
    {
      "source": "marketing_budget",
      "target": "brand_awareness",
      "type": "exact_code",
      "sensitivity_weight": 0.025,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "brand_awareness = 12.5 * log1p(marketing_budget)"
      }
    },
    {
      "source": "demand",
      "target": "sales",
      "type": "discrete_rule",
      "sensitivity_weight": 0.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "sales = min(demand, order_qty)"
      }
    },
    {
      "source": "order_qty",
      "target": "sales",
      "type": "discrete_rule",
      "sensitivity_weight": 1.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "sales = min(demand, order_qty)"
      }
    },
    {
      "source": "order_qty",
      "target": "unit_cost",
      "type": "discrete_rule",
      "sensitivity_weight": -0.2,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "unit_cost = 1.20 if order_qty < 800 else 1.00"
      }
    },
    {
      "source": "order_qty",
      "target": "holding_cost",
      "type": "exact_code",
      "sensitivity_weight": 0.2,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "holding_cost = 0.20 * max(0, order_qty - sales)"
      }
    },
    {
      "source": "sales",
      "target": "holding_cost",
      "type": "exact_code",
      "sensitivity_weight": -0.2,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "holding_cost = 0.20 * max(0, order_qty - sales)"
      }
    },
    {
      "source": "price",
      "target": "revenue",
      "type": "exact_code",
      "sensitivity_weight": 500.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "revenue = price * sales"
      }
    },
    {
      "source": "sales",
      "target": "revenue",
      "type": "exact_code",
      "sensitivity_weight": 3.5,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "revenue = price * sales"
      }
    },
    {
      "source": "revenue",
      "target": "fees",
      "type": "exact_code",
      "sensitivity_weight": 0.03,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "fees = 0.03 * revenue"
      }
    },
    {
      "source": "revenue",
      "target": "profit",
      "type": "exact_code",
      "sensitivity_weight": 1.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "profit += revenue"
      }
    },
    {
      "source": "fees",
      "target": "profit",
      "type": "exact_code",
      "sensitivity_weight": -1.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "profit -= fees"
      }
    },
    {
      "source": "unit_cost",
      "target": "profit",
      "type": "exact_code",
      "sensitivity_weight": -500.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "profit -= unit_cost * order_qty"
      }
    },
    {
      "source": "order_qty",
      "target": "profit",
      "type": "exact_code",
      "sensitivity_weight": -1.2,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "profit -= unit_cost * order_qty"
      }
    },
    {
      "source": "marketing_budget",
      "target": "profit",
      "type": "exact_code",
      "sensitivity_weight": -1.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "profit -= marketing_budget"
      }
    },
    {
      "source": "holding_cost",
      "target": "profit",
      "type": "exact_code",
      "sensitivity_weight": -1.0,
      "confidence": 1.0,
      "exact_mechanism": {
        "engine": "python_callable",
        "definition": "profit -= holding_cost"
      }
    }
  ],
  "constraints": [
    {
      "id": "c_budget",
      "type": "hard",
      "expression": "unit_cost * order_qty + marketing_budget <= 2500",
      "description": "Presupuesto máximo de costes directos y marketing de 2500€"
    },
    {
      "id": "c_ledger",
      "type": "hard",
      "expression": "sum(credits) - sum(debits) == 0",
      "description": "Invariante contable de partida doble en el libro mayor"
    },
    {
      "id": "c_stock",
      "type": "hard",
      "expression": "order_qty - sales >= 0",
      "description": "Las ventas no pueden exceder las existencias disponibles"
    },
    {
      "id": "c_price_bounds",
      "type": "hard",
      "expression": "2.0 <= price <= 6.0",
      "description": "Rango admisible de fijación de precios en el mercado"
    }
  ]
}